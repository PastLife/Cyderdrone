# ─────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)
# ค่าทั้งหมดหาได้ที่ Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# URL ของโปรเจกต์ Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# publishable / anon key — ส่งไปฝั่งเบราว์เซอร์ได้ ปลอดภัยเพราะถูก RLS คุมอยู่
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# service role key — ข้าม RLS ทั้งหมด
# ⚠️ ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามหลุดไปฝั่ง client เด็ดขาด
# ใช้สำหรับ: สร้าง/ปิดบัญชีเจ้าหน้าที่, เขียน audit log, นับการล็อกอินที่ล้มเหลว
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL ของเว็บ ใช้ประกอบลิงก์ในอีเมลตั้งรหัสผ่านใหม่
NEXT_PUBLIC_SITE_URL=http://localhost:3000
